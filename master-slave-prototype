function processCollisionImpact(r) {
    if (!r) return;
    let vNow = BABYLON.Vector3.Zero();
    try { vNow = r.agg.body.getLinearVelocity(); } catch(_){}
    const dv = vNow.subtract(r.prevVel);      // Δv за шаг физики = импульс/m от контакта
    const severity = dv.length();
    const dir = severity > 1e-5 ? dv.scale(1 / severity) : new BABYLON.Vector3(0,1,0);
    triggerHitReaction(r, severity, dir, null);
}

try {
    const CET = BABYLON.PhysicsCollisionEventType;
    physicsEngine.onCollisionObservable.add(ev => {
        if (!slaveBodyMap.size || !CET) return;
        const started = ev.type === CET.STARTED;
        const ended = ev.type === CET.ENDED;
        if (!started && !ended) return;
        const d = started ? 1 : -1;
        const ra = slaveBodyMap.get(ev.bodyA);
        const rb = slaveBodyMap.get(ev.bodyB);
        if (ra) {
            collisionCount = Math.max(0, collisionCount + d);
            if (staticBodies.has(ev.bodyB)) ra.groundContacts = Math.max(0, (ra.groundContacts||0) + d);
        }
        if (rb) {
            collisionCount = Math.max(0, collisionCount + d);
            if (staticBodies.has(ev.bodyA)) rb.groundContacts = Math.max(0, (rb.groundContacts||0) + d);
        }
        if (started && reactionsEnabled) {
            processCollisionImpact(ra);
            processCollisionImpact(rb);
        }
    });
} catch (e) { logToUI('onCollisionObservable недоступен: ' + e.message, '#ffaa00'); }

