let masterVisible = true;
$('masterVis').addEventListener('change', () => { masterVisible = $('masterVis').checked; if (masterMesh) masterMesh.setEnabled(masterVisible); });

function disposeMaster() {
    if (!masterMesh) return;
    for (const g of Object.values(masterGroups)) { if (g) { try { g.stop(); } catch(_){} } }
    try { if (masterSkeleton) masterSkeleton.dispose(); } catch(_){}
    try { masterMesh.dispose(false, true); } catch(_){}
    masterMesh = null; masterSkeleton = null; curGroup = null;
}

function createMaster(mesh, skeleton, lm, animGroups) {
    disposeMaster();
    LM = lm;
    const m = mesh.clone('master_avatar', null, true, false);
    if (!m) return;
    if (m.skeleton === skeleton || !m.skeleton) m.skeleton = skeleton.clone('master_skeleton');
    masterMesh = m;
    masterSkeleton = m.skeleton;
    m.isPickable = false;
    if (m.material) {
        const gmat = m.material.clone('masterMat');
        if (gmat) {
            gmat.alpha = 0.25;
            if (gmat.emissiveColor !== undefined) gmat.emissiveColor = new BABYLON.Color3(0.1, 0.85, 0.3);
            m.material = gmat;
        }
    }
    m.setEnabled(masterVisible);

    masterRestQuat = new Map();
    const sc = new BABYLON.Vector3(), q = new BABYLON.Quaternion(), p = new BABYLON.Vector3();
    for (const b of masterSkeleton.bones) {
        b.getLocalMatrix().decompose(sc, q, p);
        masterRestQuat.set(b, q.clone());
    }
    const depthOf = b => { let d = 0, pp = b.getParent(); while (pp) { d++; pp = pp.getParent(); } return d; };
    masterBoneOrder = masterSkeleton.bones.slice().sort((a,b) => depthOf(a) - depthOf(b));

    masterAnimBones = [];
    const sL = /_l$|_l[^a-z]|left|\.l$/i;
    const sR = /_r$|_r[^a-z]|right|\.r$/i;
    for (const b of masterSkeleton.bones) {
        const nm = b.name;
        if (excludeBones.includes(nm) || SKIP_RE.test(nm) || WELD_RE.test(nm)) continue;
        const jt = jointTypeFor(nm);
        let side = sL.test(nm) ? 'L' : (sR.test(nm) ? 'R' : null);
        if (!side && (jt === 'hip' || jt === 'knee' || jt === 'shoulder' || jt === 'elbow')) {
            try { side = BABYLON.Vector3.Dot(b.getAbsolutePosition(m).subtract(lm.center), lm.right) >= 0 ? 'R' : 'L'; }
            catch(_) { side = 'R'; }
        }
        masterAnimBones.push({ bone:b, jt, side, name:nm });
    }

    masterGroups = { idle:null, walk:null, run:null, fall:null };
    for (const g of (animGroups || [])) {
        try { g.stop(); } catch(_){}
        try { g.retargetTo(masterSkeleton); } catch(_){}
        const n = (g.name || '').toLowerCase();
        if (/idle|stand|breath|neutral/i.test(n) && !masterGroups.idle) masterGroups.idle = g;
        else if (/walk/i.test(n) && !masterGroups.walk) masterGroups.walk = g;
        else if (/run|sprint|jog/i.test(n) && !masterGroups.run) masterGroups.run = g;
        else if (/fall|jump|air|float/i.test(n) && !masterGroups.fall) masterGroups.fall = g;
    }
    masterMode = (masterGroups.idle && (masterGroups.walk || masterGroups.run)) ? 'groups' : 'procedural';
    logToUI('🎭 Master создан: ' + masterSkeleton.bones.length + ' костей, режим: ' + masterMode, '#44ff88');
}

function updateMasterController(dt) {
    if (!masterMesh || !rootRef || !LM) return;
    const pos = masterMesh.position;

    const ray = new BABYLON.Ray(pos.add(new BABYLON.Vector3(0,0.35,0)), new BABYLON.Vector3(0,-1,0), 6);
    const hit = scene.pickWithRay(ray, supportPredicate);
    let groundY = 0;
    if (hit && hit.hit && hit.pickedPoint) groundY = hit.pickedPoint.y;
    groundedMaster = (pos.y - groundY) < P.groundDistance + 0.15;

    const fwd = (keys.has('KeyW') || keys.has('ArrowUp') ? 1 : 0) - (keys.has('KeyS') || keys.has('ArrowDown') ? 1 : 0);
    const side = (keys.has('KeyD') || keys.has('ArrowRight') ? 1 : 0) - (keys.has('KeyA') || keys.has('ArrowLeft') ? 1 : 0);
    const running = keys.has('ShiftLeft') || keys.has('ShiftRight');
    const moving = (fwd !== 0 || side !== 0);

    charState = !groundedMaster ? 'FALLING' : (moving ? (running ? 'RUNNING' : 'WALKING') : 'IDLE');
    if (charState !== 'FALLING') masterFallVel = 0;

    let moveDir = BABYLON.Vector3.Zero();
    const camDir = camera.getForwardRay().direction.clone();
    camDir.y = 0;
    if (camDir.lengthSquared() < 1e-6) camDir.set(0,0,-1);
    camDir.normalize();
    const camRight = BABYLON.Vector3.Cross(camDir, new BABYLON.Vector3(0,1,0)).normalize();
    if (moving) {
        moveDir = camDir.scale(fwd).add(camRight.scale(side)).normalize();
        const targetYaw = Math.atan2(BABYLON.Vector3.Cross(LM.forward, moveDir).y, BABYLON.Vector3.Dot(LM.forward, moveDir));
        masterYaw = smoothDampAngle(masterYaw, targetYaw, dt, P.turnSmoothTime);
    }
    masterMesh.rotationQuaternion = BABYLON.Quaternion.RotationAxis(new BABYLON.Vector3(0,1,0), masterYaw);

    const slaveRootPos = rootRef.mesh.getAbsolutePosition();
    const s2m = slaveRootPos.subtract(pos);
    s2m.y = 0;
    const dist = s2m.length();
    const ratio = clampF(dist / P.maxPossibleDistanceFromRagdoll, 0, 1);
    const mag = smoothstep(0, 1, ratio);
    const pushVec = dist > 1e-5 ? s2m.scale(Math.min(mag, dist) / dist) : BABYLON.Vector3.Zero();

    const masterMoveScale = clampF(followingScale, 0, 1);
    const pushScale = 1 + (1 - followingScale) * 2;

    if (charState === 'FALLING') {
        masterFallVel -= P.gravity * dt;
        pos.y += masterFallVel * dt;
    } else if (charState === 'IDLE') {
        pos.addInPlace(pushVec.scale(P.pushBackSpeed * pushScale * dt));
    } else {
        const baseSpeed = charState === 'RUNNING' ? P.runSpeed : P.walkSpeed;
        const forward = moveDir.scale(baseSpeed * masterMoveScale);

        // БЛОКИРОВКА ШАГА: не даём мастеру "взлетать" на препятствие выше maxStepHeight
        if (supportGuard && forward.lengthSquared() > 1e-8) {
            const dirN = moveDir.clone();
            dirN.normalize();
            const aheadY = raycastSupportY(pos.x + dirN.x * 0.5, pos.z + dirN.z * 0.5, pos.y + 1.5);
            if (aheadY !== null && aheadY - groundY > P.maxStepHeight) {
                forward.set(0, 0, 0);
            }
        }

        const back = pushVec.scale(P.pushBackSpeed * pushScale);
        pos.addInPlace(forward.add(back).scale(dt));
    }

    if (pos.y < groundY + P.groundDistance + masterBobY) {
        pos.y = groundY + P.groundDistance + masterBobY;
        masterFallVel = 0;
    } else if (groundedMaster) {
        pos.y = lerpF(pos.y, groundY + P.groundDistance + masterBobY, Math.min(1, dt*12));
    }

    masterMesh.computeWorldMatrix(true);
}

function updateMasterAnimation(dt, t) {
    if (!masterMesh || !masterSkeleton) return;
    if (masterMode === 'groups') {
        let want = masterGroups.idle;
        if (charState === 'FALLING') want = masterGroups.fall || masterGroups.idle;
        else if (charState === 'RUNNING') want = masterGroups.run || masterGroups.walk || masterGroups.idle;
        else if (charState === 'WALKING') want = masterGroups.walk || masterGroups.idle;
        if (want && curGroup !== want) {
            if (curGroup) { try { curGroup.stop(); } catch(_){} }
            try { want.play(true); } catch(_){}
            curGroup = want;
        }
        masterBobY = 0;
        return;
    }

    const moving = (charState === 'WALKING' || charState === 'RUNNING') && groundedMaster;
    const rate = charState === 'RUNNING' ? 11 : 7.5;
    if (moving) walkPhase += dt * rate;
    ampCur += ((moving ? 1 : 0) - ampCur) * Math.min(1, dt*6);
    fallBlend += ((charState === 'FALLING' ? 1 : 0) - fallBlend) * Math.min(1, dt*5);
    const A = ampCur, ph = walkPhase, F = fallBlend;
    const breath = Math.sin(t * 1.7);

    const adds = new Map();
    const R = LM.right, U = LM.up;
    for (const ab of masterAnimBones) {
        const phSide = ph + (ab.side === 'L' ? 0 : Math.PI);
        let angle = 0, axis = R;
        if (ab.jt === 'hip') {
            angle = A * Math.sin(phSide) * 35 * D2R;
            angle = lerpF(angle, -25*D2R, F);
        } else if (ab.jt === 'knee') {
            angle = -A * Math.max(0, Math.sin(phSide + 0.9)) * 75 * D2R - 3*D2R;
            angle = lerpF(angle, -50*D2R, F);
        } else if (ab.jt === 'shoulder') {
            angle = A * Math.sin(phSide + Math.PI) * 32 * D2R + (1-A) * breath * 1.5 * D2R;
            angle = lerpF(angle, 150*D2R, F);
        } else if (ab.jt === 'elbow') {
            angle = A * Math.max(0, Math.sin(phSide + Math.PI - 0.8)) * 55 * D2R + 8*D2R;
            angle = lerpF(angle, 45*D2R, F);
        } else if (ab.jt === 'spine') {
            const n = ab.name.toLowerCase();
            if (/pelvis|hips/.test(n) && !/thigh|upper_leg/.test(n)) {
                axis = U; angle = -A * Math.sin(ph) * 4 * D2R;
            } else if (/neck/.test(n)) {
                axis = U; angle = -A * Math.sin(ph) * 2 * D2R;
            } else if (/head/.test(n)) {
                axis = U; angle = -A * Math.sin(ph) * 2.5 * D2R;
            } else if (/chest|spine|back|thorax|abdomen|torso/.test(n)) {
                const qYaw = BABYLON.Quaternion.RotationAxis(U, A * Math.sin(ph) * 5 * D2R);
                const qPitch = BABYLON.Quaternion.RotationAxis(R, breath * 1.8 * D2R * (1 - A*0.5) + F * 8 * D2R);
                adds.set(ab.bone, qYaw.multiply(qPitch));
                continue;
            } else continue;
        } else continue;
        adds.set(ab.bone, BABYLON.Quaternion.RotationAxis(axis, angle));
    }

    animWorldQ.clear();
    const IDQ = BABYLON.Quaternion.Identity();
    for (const bone of masterBoneOrder) {
        const parent = bone.getParent();
        const qPA = parent ? (animWorldQ.get(parent) || IDQ) : IDQ;
        const qRest = masterRestQuat.get(bone) || IDQ;
        const qBase = qPA.multiply(qRest);
        const add = adds.get(bone);
        const qW = add ? add.multiply(qBase) : qBase;
        animWorldQ.set(bone, qW);
        if (add) bone.setRotationQuaternion(qPA.conjugate().multiply(qW), BABYLON.Space.LOCAL);
    }
    masterBobY = groundedMaster ? Math.abs(Math.sin(walkPhase)) * 0.03 * ampCur : 0;
}

