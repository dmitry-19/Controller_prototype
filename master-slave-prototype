function createRagdoll(skeleton, mesh, lm) {
    if (syncObserver) { scene.onBeforeRenderObservable.remove(syncObserver); syncObserver = null; }
    for (const c of constraints) { try { c.dispose(); } catch(_){} }
    constraints = [];
    for (const ref of colliderRefs) { if (ref.savedLinkedNode) { try { ref.bone.linkTransformNode(ref.savedLinkedNode); } catch(_){} } }
    for (const ref of colliderRefs) { try { ref.agg.dispose(); } catch(_){} try { ref.mesh.dispose(); } catch(_){} }
    colliderRefs = [];
    slaveBodyMap.clear();
    rootRef = null;
    boneToRef = new Map();
    scene.meshes.forEach(m => { if (m.name.startsWith('col_')) m.dispose(); });

    skinnedMesh = mesh;
    skelRef = skeleton;
    LM = lm;
    mesh.computeWorldMatrix(true);

    restLocalMatrix = new Map();
    for (const b of skeleton.bones) restLocalMatrix.set(b, b.getLocalMatrix().clone());

    const positions = mesh.getVerticesData(BABYLON.VertexBuffer.PositionKind);
    const matricesIndices = mesh.getVerticesData(BABYLON.VertexBuffer.MatricesIndicesKind);
    const matricesWeights = mesh.getVerticesData(BABYLON.VertexBuffer.MatricesWeightsKind);
    if (!positions || !matricesIndices || !matricesWeights) { logToUI('Нет скиннинга', '#ff4444'); return; }

    const numVertices = positions.length / 3;
    const boneNameToIndex = {};
    skeleton.bones.forEach((b,i) => boneNameToIndex[b.name] = i);
    const boneVertexIndices = Array.from({ length: skeleton.bones.length }, () => []);
    for (let i = 0; i < numVertices; i++) {
        let mw = matricesWeights[i*4], mi = matricesIndices[i*4];
        for (let k = 1; k < 4; k++) {
            if (matricesWeights[i*4+k] > mw) { mw = matricesWeights[i*4+k]; mi = matricesIndices[i*4+k]; }
        }
        if (mw > 0.5 && mi >= 0 && mi < skeleton.bones.length) boneVertexIndices[mi].push(i);
    }

    const groups = [];
    const usedBones = new Set();
    for (const gName of Object.keys(boneGroups)) {
        const boneNames = boneGroups[gName];
        const idxs = [], brefs = [];
        let valid = false;
        for (const nm of boneNames) {
            const ix = boneNameToIndex[nm];
            if (ix === undefined) continue;
            valid = true;
            usedBones.add(ix);
            brefs.push(skeleton.bones[ix]);
            for (const vi of boneVertexIndices[ix]) idxs.push(vi);
        }
        if (!valid || idxs.length < 4) continue;
        groups.push({ name:gName, vertexIndices:[...new Set(idxs)], primaryBone:brefs[0], boneNames:brefs.map(b => b.name).join('+') });
    }
    for (let i = 0; i < skeleton.bones.length; i++) {
        const bn = skeleton.bones[i].name;
        if (usedBones.has(i) || excludeBones.includes(bn) || SKIP_RE.test(bn)) continue;
        if (boneVertexIndices[i].length < 4) continue;
        groups.push({ name:bn, vertexIndices:boneVertexIndices[i], primaryBone:skeleton.bones[i], boneNames:bn });
    }

    const masterBoneByName = new Map();
    if (masterSkeleton) for (const b of masterSkeleton.bones) masterBoneByName.set(b.name, b);

    const tmpV = new BABYLON.Vector3();
    let weldCount = 0;
    for (const group of groups) {
        const bone = group.primaryBone;
        const invBind = bone.getAbsoluteInverseBindMatrix();
        let minX = Infinity, minY = Infinity, minZ = Infinity;
        let maxX = -Infinity, maxY = -Infinity, maxZ = -Infinity;
        for (const vi of group.vertexIndices) {
            tmpV.set(positions[vi*3], positions[vi*3+1], positions[vi*3+2]);
            BABYLON.Vector3.TransformCoordinatesToRef(tmpV, invBind, tmpV);
            if (tmpV.x < minX) minX = tmpV.x;
            if (tmpV.y < minY) minY = tmpV.y;
            if (tmpV.z < minZ) minZ = tmpV.z;
            if (tmpV.x > maxX) maxX = tmpV.x;
            if (tmpV.y > maxY) maxY = tmpV.y;
            if (tmpV.z > maxZ) maxZ = tmpV.z;
        }
        const size = new BABYLON.Vector3(maxX-minX, maxY-minY, maxZ-minZ);
        const center = new BABYLON.Vector3((minX+maxX)/2, (minY+maxY)/2, (minZ+maxZ)/2);
        if (size.lengthSquared() < 0.0005) continue;

        const boneWorld = BABYLON.Matrix.Invert(invBind);
        const centerWorld = BABYLON.Vector3.TransformCoordinates(center, boneWorld);
        let boneWorldRot = null;
        try { boneWorldRot = bone.getRotationQuaternion(BABYLON.Space.WORLD, mesh); } catch(_){}
        if (!boneWorldRot) boneWorldRot = BABYLON.Quaternion.FromRotationMatrix(boneWorld.getRotationMatrix());

        const isWelded = WELD_RE.test(group.name);
        const box = BABYLON.MeshBuilder.CreateBox('col_' + group.name, { width:size.x, height:size.y, depth:size.z }, scene);
        box.position.copyFrom(centerWorld);
        box.rotationQuaternion = boneWorldRot.clone();
        box.computeWorldMatrix(true);
        box.visibility = 0.3;
        const mat = new BABYLON.StandardMaterial('cm_' + group.name, scene);
        mat.diffuseColor = isWelded ? new BABYLON.Color3(1.0,0.7,0.3) : new BABYLON.Color3(0.2,0.8,1.0);
        mat.alpha = 0.35;
        box.material = mat;

        const colName = classifyGroup(group.name);
        const isFootWeld = isWelded && /foot|ball/.test(group.name);
        const agg = new BABYLON.PhysicsAggregate(box, BABYLON.PhysicsShapeType.BOX, {
            mass: massFor(group.name), restitution:0,
            friction: isFootWeld ? 1.6 : 0.85,
            linearDamping: P.linDamp, angularDamping: P.angDamp,
            collisionGroup: COL_GROUP[colName],
            collisionMask: COL_MASK[colName] !== undefined ? COL_MASK[colName] : ~0
        }, scene);
        agg.body.setMotionType(BABYLON.PhysicsMotionType.DYNAMIC);
        try { agg.body.setMaxLinearVelocity(18); agg.body.setMaxAngularVelocity(45); } catch(_){}

        const masterBone = masterBoneByName.get(bone.name) || null;
        const jt = isWelded ? 'weld' : jointTypeFor(group.name);
        const ref = {
            mesh:box, agg, bone, masterBone, name:group.name, boneNames:group.boneNames,
            bindCenter:center, boxSize:size.clone(),
            isRoot:false, parentRef:null, jt, isWelded, isFootWeld,
            children:[],
            fProfile: forceProfileFor(jt), tProfile: torqueProfileFor(jt),
            effF: forceProfileFor(jt), effT: torqueProfileFor(jt),
            lastTargetCOM:null, lastMRot:null, lastPoseErr:0, trackErrMag:0,
            groundContacts:0, savedLinkedNode:null,
            limp:0, flashTimer:0, baseEmissive:new BABYLON.Color3(0,0,0),
            stress:0, driveStress:0,
            prevVel: BABYLON.Vector3.Zero()
        };
        colliderRefs.push(ref);
        boneToRef.set(bone, ref);
        slaveBodyMap.set(agg.body, ref);
        if (isWelded) weldCount++;
    }

    for (const ref of colliderRefs) {
        const tn = ref.bone.getTransformNode();
        if (tn) { ref.savedLinkedNode = tn; ref.bone.linkTransformNode(null); }
    }

    const depthOf = b => { let d = 0, pp = b.getParent(); while (pp) { d++; pp = pp.getParent(); } return d; };
    for (const r of colliderRefs) {
        if (!rootRef || depthOf(r.bone) < depthOf(rootRef.bone)) rootRef = r;
    }
    if (rootRef) {
        rootRef.isRoot = true;
        pelvisOffset.copyFrom(rootRef.bone.getAbsolutePosition(mesh).subtract(mesh.position));
        restPelvisY = rootRef.mesh.getAbsolutePosition().y;
    }

    // rest-высота корня над низом стоп — "потолок" подъёма для охраны опоры
    let feetBottom = Infinity;
    for (const ref of colliderRefs) {
        if (!ref.isFootWeld) continue;
        try {
            const bb = ref.mesh.getBoundingInfo().boundingBox;
            if (bb.minimumWorld.y < feetBottom) feetBottom = bb.minimumWorld.y;
        } catch(_){}
    }
    if (!isFinite(feetBottom)) feetBottom = 0;
    restRootAboveSupport = Math.max(0.2, restPelvisY - feetBottom);

    let joints = 0;
    for (const ref of colliderRefs) {
        let pb = ref.bone.getParent();
        let parentRef = null;
        while (pb) {
            parentRef = boneToRef.get(pb) || colliderRefs.find(r => r.boneNames && r.boneNames.split('+').includes(pb.name));
            if (parentRef) break;
            pb = pb.getParent();
        }
        if (!parentRef) parentRef = rootRef;
        if (!parentRef || parentRef === ref) continue;
        ref.parentRef = parentRef;
        parentRef.children.push(ref);

        const jointWorld = ref.bone.getAbsolutePosition(mesh);
        const invP = BABYLON.Matrix.Invert(parentRef.mesh.getWorldMatrix());
        const invC = BABYLON.Matrix.Invert(ref.mesh.getWorldMatrix());
        const pivotA = BABYLON.Vector3.TransformCoordinates(jointWorld, invP);
        const pivotB = BABYLON.Vector3.TransformCoordinates(jointWorld, invC);

        if (ref.isWelded) {
            const con = new BABYLON.Physics6DoFConstraint({
                pivotA, pivotB,
                axisA: BABYLON.Vector3.TransformNormal(BABYLON.Axis.X, invP).normalize(),
                axisB: BABYLON.Vector3.TransformNormal(BABYLON.Axis.X, invC).normalize(),
                perpAxisA: BABYLON.Vector3.TransformNormal(BABYLON.Axis.Y, invP).normalize(),
                perpAxisB: BABYLON.Vector3.TransformNormal(BABYLON.Axis.Y, invC).normalize(),
                parentIsFirst: true
            }, LOCKED_6DOF(), scene);
            parentRef.agg.body.addConstraint(ref.agg.body, con);
            try { con.isCollisionsEnabled = false; } catch(_){}
            constraints.push(con);
            joints++;
            continue;
        }

        const axes = buildJointWorldAxes(ref, LM, mesh);
        ref.jt = axes.jt;
        const lim = axes.lim;
        const con = new BABYLON.Physics6DoFConstraint({
            pivotA, pivotB,
            axisA: BABYLON.Vector3.TransformNormal(axes.Xw, invP).normalize(),
            axisB: BABYLON.Vector3.TransformNormal(axes.Xw, invC).normalize(),
            perpAxisA: BABYLON.Vector3.TransformNormal(axes.Yw, invP).normalize(),
            perpAxisB: BABYLON.Vector3.TransformNormal(axes.Yw, invC).normalize(),
            parentIsFirst: true
        }, [
            { axis: BABYLON.PhysicsConstraintAxis.LINEAR_X, minLimit:0, maxLimit:0 },
            { axis: BABYLON.PhysicsConstraintAxis.LINEAR_Y, minLimit:0, maxLimit:0 },
            { axis: BABYLON.PhysicsConstraintAxis.LINEAR_Z, minLimit:0, maxLimit:0 },
            { axis: BABYLON.PhysicsConstraintAxis.ANGULAR_X, minLimit:lim.X[0]*D2R, maxLimit:lim.X[1]*D2R },
            { axis: BABYLON.PhysicsConstraintAxis.ANGULAR_Y, minLimit:lim.Y[0]*D2R, maxLimit:lim.Y[1]*D2R },
            { axis: BABYLON.PhysicsConstraintAxis.ANGULAR_Z, minLimit:(lim.Z ? lim.Z[0] : -15)*D2R, maxLimit:(lim.Z ? lim.Z[1] : 15)*D2R },
        ], scene);
        parentRef.agg.body.addConstraint(ref.agg.body, con);
        try { con.isCollisionsEnabled = false; } catch(_){}
        constraints.push(con);
        joints++;
    }

    logToUI('🦴 Slave: ' + colliderRefs.length + ' тел (сварки: ' + weldCount + '), суставов: ' + joints + '. Ноги: rest-высота таза ' + restRootAboveSupport.toFixed(2) + ' м', '#44ff88');
    populateSelect();
    resetStability();
    wakeAll();

    let frameCounter = 0;
    const decS = new BABYLON.Vector3(), decQ = new BABYLON.Quaternion(), decP = new BABYLON.Vector3();
    syncObserver = scene.onBeforeRenderObservable.add(() => {
        const dt = clampF(engine.getDeltaTime()/1000, 1/240, 1/15);
        const t = performance.now()/1000;
        frameCounter++;
        guardClamped = false;

        if (masterMesh && rootRef) {
            updateMasterController(dt);
            updateMasterAnimation(dt, t);
            try { masterMesh.computeWorldMatrix(true); } catch(_){}
            try { masterSkeleton.computeAbsoluteMatrices(); } catch(_){}
        }
        if (activeEnabled) {
            updateReactions(dt);
            updateStability(dt);
            updateSlaveController(dt);
            followAnimation(dt);
            applyBalance(dt);
        }
        updateDragSpring(dt);

        if (skinnedMesh && rootRef && skelRef) {
            const rootBox = rootRef.mesh;
            const boxRot = rootBox.getWorldMatrix().getRotationMatrix();
            const cOff = BABYLON.Vector3.TransformNormal(rootRef.bindCenter, boxRot);
            skinnedMesh.position.copyFrom(rootBox.getAbsolutePosition().subtract(cOff).subtract(pelvisOffset));
            skinnedMesh.computeWorldMatrix(true);

            const meshPos = skinnedMesh.position;
            const oneOverS = 1 / (skinnedMesh.scaling.x || 1);
            const tracked = new Map();
            for (const bone of skelRef.bones) {
                const parent = bone.getParent();
                const Pm = parent ? tracked.get(parent) : null;
                const ref = boneToRef.get(bone);
                if (ref) {
                    const bw = ref.mesh.getWorldMatrix();
                    const off = BABYLON.Vector3.TransformNormal(ref.bindCenter, bw.getRotationMatrix());
                    const pW = ref.mesh.getAbsolutePosition().subtract(off);
                    const tPos = pW.subtract(meshPos).scaleInPlace(oneOverS);
                    const T = BABYLON.Matrix.ComposeToRef(
                        BABYLON.Vector3.One(),
                        ref.mesh.absoluteRotationQuaternion || BABYLON.Quaternion.Identity(),
                        tPos,
                        new BABYLON.Matrix()
                    );
                    let Lm;
                    if (Pm) { const iP = Pm.clone(); iP.invert(); Lm = T.clone().multiply(iP); }
                    else Lm = T.clone();
                    Lm.decompose(decS, decQ, decP);
                    bone.position = decP;
                    bone.setRotationQuaternion(decQ, BABYLON.Space.LOCAL);
                    tracked.set(bone, T);
                } else {
                    const rest = restLocalMatrix.get(bone);
                    const W = (Pm && rest) ? rest.clone().multiply(Pm) : (rest ? rest.clone() : BABYLON.Matrix.Identity());
                    tracked.set(bone, W);
                }
            }
            skinnedMesh.computeWorldMatrix(true);
        }

        if (rootRef) {
            const tp = rootRef.mesh.getAbsolutePosition().add(new BABYLON.Vector3(0, 0.35, 0));
            camera.target = BABYLON.Vector3.Lerp(camera.target, tp, Math.min(1, dt*4));
        }

        // сэмплируем prevVel В КОНЦЕ кадра (после наших импульсов) — для регистрации Δv коллизий
        for (const ref of colliderRefs) {
            try { ref.prevVel.copyFrom(ref.agg.body.getLinearVelocity()); } catch(_){}
        }

        if (frameCounter % 15 === 0) { updateMSInfo(); updateStabInfo(); updateSupportInfo(); }
        if (frameCounter % 25 === 0 && !logPaused) updateAngleLog();
    });

    statusEl.innerHTML = 'Master-Slave ragdoll: ' + colliderRefs.length + ' тел, joints: ' + joints + ', master: ' + masterMode;
    angleCountEl.textContent = colliderRefs.length;
}

// ======================================================================= БАЛАНС
function applyBalance(dt) {
    if (!balanceEnabled || !slaveAlive || !rootRef || !colliderRefs.length) return;
    if (dragState) return;
    if (dt <= 0) return;
    if (staggerTimer > 0) return;
    if (ragdollActive) return;

    const rootBody = rootRef.agg.body;
    const pelvisQ = rootRef.mesh.absoluteRotationQuaternion || BABYLON.Quaternion.Identity();
    const pelvisUp = rotateVecByQuat(new BABYLON.Vector3(0,1,0), pelvisQ);
    if (pelvisUp.y < 0.4) return;

    let totalMass = 0;
    const com = BABYLON.Vector3.Zero();
    for (const ref of colliderRefs) {
        let m = 1; try { m = ref.agg.body.getMass()||1; } catch(_){}
        com.addInPlace(ref.mesh.getAbsolutePosition().scale(m));
        totalMass += m;
    }
    if (totalMass <= 0) return;
    com.scaleInPlace(1/totalMass);

    let nG = 0;
    const sup = BABYLON.Vector3.Zero();
    for (const ref of colliderRefs) {
        if (ref.groundContacts > 0) { sup.addInPlace(ref.mesh.getAbsolutePosition()); nG++; }
    }
    if (nG === 0) return;
    sup.scaleInPlace(1/nG);

    const errX = com.x - sup.x;
    const errZ = com.z - sup.z;
    let rv = BABYLON.Vector3.Zero();
    try { rv = rootBody.getLinearVelocity(); } catch(_){}
    let rm = 1; try { rm = rootBody.getMass()||1; } catch(_){}
    let fx = -P.KpBal * errX - P.KdBal * rv.x;
    let fz = -P.KpBal * errZ - P.KdBal * rv.z;
    const fmax = P.maxBalForce * rm;
    const fmag = Math.hypot(fx, fz);
    if (fmag > fmax) { fx *= fmax/fmag; fz *= fmax/fmag; }
    try {
        rootBody.applyImpulse(new BABYLON.Vector3(fx, 0, fz).scale(rm*dt), rootRef.mesh.getAbsolutePosition());
        rootBody.wakeUp();
    } catch(_){}

    const upErr = BABYLON.Vector3.Cross(pelvisUp, new BABYLON.Vector3(0,1,0));
    let w = BABYLON.Vector3.Zero();
    try { w = rootBody.getAngularVelocity(); } catch(_){}
    const torque = upErr.scale(P.KpUpright).subtract(w.scale(P.KdUpright));
    const bs = rootRef.boxSize;
    const I = rm/12*(bs.y*bs.y + bs.z*bs.z);
    try { rootBody.applyTorqueImpulse(torque.scale(I*dt)); } catch(_){}
}

// ======================================================================= AnimationFollowing
function followAnimation(dt) {
    if (!colliderRefs.length || !masterMesh || dt <= 0) return;
    if (!slaveAlive) return;

    const mScale = masterMesh.scaling.x || 1;
    const kdPos = 2 * P.zetaPos * Math.sqrt(Math.max(1, P.KpPos));
    const kdAngBase = 2 * P.zetaAng * Math.sqrt(Math.max(1, P.KpAng));
    let sumP = 0, sumR = 0, n = 0;

    for (const ref of colliderRefs) {
        if (dragState && dragState.ref === ref) continue;
        if (!ref.masterBone) continue;
        const body = ref.agg.body;

        let mPos, mRot;
        try {
            mPos = ref.masterBone.getAbsolutePosition(masterMesh);
            mRot = ref.masterBone.getRotationQuaternion(BABYLON.Space.WORLD, masterMesh);
        } catch(_) { continue; }
        if (!mRot) continue;

        const grounded = ref.groundContacts > 0;
        const passiveWeld = ref.isWelded && grounded && ref.isFootWeld;

        const off = rotateVecByQuat(ref.bindCenter.scale(mScale), mRot);
        const targetCOM = mPos.add(off);
        const slaveCOM = ref.mesh.getAbsolutePosition();
        const err = targetCOM.subtract(slaveCOM);
        ref.trackErrMag = err.length();

        if (!passiveWeld) {
            let vS = BABYLON.Vector3.Zero();
            try { vS = body.getLinearVelocity(); } catch(_){}
            let vM = BABYLON.Vector3.Zero();
            if (ref.lastTargetCOM && dt > 1e-5) vM = targetCOM.subtract(ref.lastTargetCOM).scale(1/dt);
            ref.lastTargetCOM = targetCOM.clone();

            const vRel = vS.subtract(vM);
            const acc = err.scale(P.KpPos).subtract(vRel.scale(kdPos));
            const aMax = P.maxAccel * ref.effF * forceCoefficient * staggerCoef * followingScale;
            const aLen = acc.length();
            if (aLen > aMax) acc.scaleInPlace(aMax / aLen);

            let mass = 1;
            try { mass = body.getMass() || 1; } catch(_){}
            try { body.applyImpulse(acc.scale(mass * dt), slaveCOM); body.wakeUp(); } catch(_){}
            sumP += err.length(); n++;
        } else {
            ref.lastTargetCOM = targetCOM.clone();
        }

        {
            const qCur = ref.mesh.absoluteRotationQuaternion || ref.mesh.rotationQuaternion || BABYLON.Quaternion.Identity();
            let qErr = qCur.conjugate().multiply(mRot);
            if (qErr.w < 0) qErr = qErr.scale(-1);
            const rvL = quatToRotVec(qErr);

            let wmW = BABYLON.Vector3.Zero();
            if (ref.lastMRot && dt > 1e-5) {
                let qd = mRot.multiply(ref.lastMRot.conjugate());
                if (qd.w < 0) qd = qd.scale(-1);
                wmW = quatToRotVec(qd).scale(1/dt);
            }
            ref.lastMRot = mRot.clone();

            const qInv = qCur.conjugate();
            let wS = BABYLON.Vector3.Zero();
            try { wS = body.getAngularVelocity(); } catch(_){}
            const wRelL = rotateVecByQuat(wS, qInv).subtract(rotateVecByQuat(wmW, qInv));

            let mass = 1;
            try { mass = body.getMass() || 1; } catch(_){}
            const sx = ref.boxSize.x, sy = ref.boxSize.y, sz = ref.boxSize.z;
            const ix = mass/12*(sy*sy + sz*sz);
            const iy = mass/12*(sx*sx + sz*sz);
            const iz = mass/12*(sx*sx + sy*sy);

            const kpEff = P.KpAng * torqueCoefficient * staggerCoef * followingScale * ref.effT;
            const kdEff = kdAngBase * ref.effT;

            let ax = kpEff*rvL.x - kdEff*wRelL.x;
            let ay = kpEff*rvL.y - kdEff*wRelL.y;
            let az = kpEff*rvL.z - kdEff*wRelL.z;
            ax = clampF(ax, -ANG_ACC_MAX, ANG_ACC_MAX);
            ay = clampF(ay, -ANG_ACC_MAX, ANG_ACC_MAX);
            az = clampF(az, -ANG_ACC_MAX, ANG_ACC_MAX);

            const L = new BABYLON.Vector3(ix*ax*dt, iy*ay*dt, iz*az*dt);
            const Lmax = P.maxJointTorque * ref.effT * Math.max(torqueCoefficient*staggerCoef*followingScale, 0.05) * dt;
            const Ll = L.length();
            if (Ll > Lmax) L.scaleInPlace(Lmax / Ll);

            const Lw = rotateVecByQuat(L, qCur);
            let applied = false;
            try { body.applyTorqueImpulse(Lw); applied = true; } catch(_){}
            if (!applied) { try { body.applyTorque(Lw.scale(1/dt)); } catch(_){} }

            sumR += rvL.length() / D2R;
        }
    }
    followErrPos = n ? (sumP / n) * 100 : 0;
    followErrRot = n ? sumR / n : 0;
}

// ======================================================================= SlaveController
function updateSlaveController(dt) {
    if (!slaveAlive) {
        slaveStateTxt = 'DEAD';
        forceCoefficient = 0;
        torqueCoefficient = 0;
        slaveDeadStep += dt;
        if (slaveDeadStep >= P.deadTime) comeAlive();
        return;
    }
    if (collisionCount > 0) slaveStateTxt = 'LOOSING_STRENGTH';
    else if (slaveStrength < 1) slaveStateTxt = 'GAINING_STRENGTH';
    else slaveStateTxt = 'FOLLOWING_ANIMATION';

    if (slaveStateTxt === 'LOOSING_STRENGTH') slaveStrength = clampF(slaveStrength - P.looseStrengthLerp * dt, 0, 1);
    else if (slaveStateTxt === 'GAINING_STRENGTH') slaveStrength = clampF(slaveStrength + P.gainStrengthLerp * dt, 0, 1);

    forceCoefficient  = lerpF(P.minContactForce,  1, slaveStrength);
    torqueCoefficient = lerpF(P.minContactTorque, 1, slaveStrength);
}

function die() {
    slaveAlive = false;
    slaveDeadStep = 0;
    resetForces();
    wakeAll();
    logToUI('💀 Die: рагдолл обмяк. ComeAlive через ' + P.deadTime.toFixed(1) + ' с', '#ff8888');
}
function comeAlive() {
    slaveAlive = true;
    resetStability();
    wakeAll();
    logToUI('❤️ Come alive: постепенное восстановление', '#88ff88');
}
function resetForces() {
    forceCoefficient = 0;
    torqueCoefficient = 0;
    slaveStrength = 0;
}
$('dieBtn').addEventListener('click', die);
$('aliveBtn').addEventListener('click', () => { slaveDeadStep = P.deadTime; comeAlive(); });
$('resetForcesBtn').addEventListener('click', () => { resetForces(); logToUI('🧲 Reset forces: strength=0', '#ffcc88'); });
$('snapBtn').addEventListener('click', snapSlaveToMaster);

function snapSlaveToMaster() {
    if (!colliderRefs.length || !masterMesh) return;
    const mScale = masterMesh.scaling.x || 1;
    for (const ref of colliderRefs) {
        if (!ref.masterBone) continue;
        let mPos, mRot;
        try {
            mPos = ref.masterBone.getAbsolutePosition(masterMesh);
            mRot = ref.masterBone.getRotationQuaternion(BABYLON.Space.WORLD, masterMesh);
        } catch(_) { continue; }
        if (!mRot) continue;
        const pos = mPos.add(rotateVecByQuat(ref.bindCenter.scale(mScale), mRot));
        try { ref.agg.body.setTransformation(pos, mRot); } catch(_){}
        ref.agg.body.setLinearVelocity(BABYLON.Vector3.Zero());
        ref.agg.body.setAngularVelocity(BABYLON.Vector3.Zero());
        ref.lastTargetCOM = null;
        ref.lastMRot = null;
        ref.limp = 0;
        try { ref.prevVel.set(0,0,0); } catch(_){}
    }
    slaveAlive = true;
    slaveStrength = 1;
    slaveDeadStep = P.deadTime;
    collisionCount = 0;
    staggerTimer = 0;
    staggerCoef = 1;
    forceCoefficient = 1;
    torqueCoefficient = 1;
    resetStability();
    limpWaveQueue = [];
    wakeAll();
    logToUI('⟲ Slave телепортирован в позу мастера', '#88ddff');
}

// ======================================================================= статус / лог
function updateSupportInfo() {
    if (!supportInfoEl) return;
    if (!colliderRefs.length || !rootRef) { supportInfoEl.textContent = 'опора: —'; return; }
    if (!dragState) feetSupportInfo = getFeetSupport();
    const fs = feetSupportInfo;
    const rootY = rootRef.mesh.getAbsolutePosition().y;
    const maxY = (fs.supportY !== null) ? (fs.supportY + restRootAboveSupport) : null;
    supportInfoEl.innerHTML =
        'опора стоп: <b style="color:' + (fs.supported > 0 ? '#8f8' : '#f88') + '">' + fs.supported + '/' + fs.total + '</b>' +
        (fs.supportY !== null ? ' | поверхность y=' + fs.supportY.toFixed(2) : '') +
        ' | таз y=' + rootY.toFixed(2) + (maxY !== null ? ' (потолок ' + maxY.toFixed(2) + ')' : '') +
        (guardClamped ? ' | <span style="color:#fc8">🦶 тяга вверх ограничена</span>' : '');
}

function updateStabInfo() {
    const el = $('stabInfo');
    if (!el) return;
    const avgStress = colliderRefs.length ? (colliderRefs.reduce((s,r)=>s+r.stress,0)/colliderRefs.length) : 0;
    const avgLimp = colliderRefs.length ? (colliderRefs.reduce((s,r)=>s+r.limp,0)/colliderRefs.length) : 0;
    el.innerHTML = 'stability <b style="color:#fc8">' + globalStability.toFixed(2) + '</b> | ' +
        'following <b style="color:#8cf">' + followingScale.toFixed(2) + '</b> | stress ' + avgStress.toFixed(2) +
        ' | limp ' + avgLimp.toFixed(2) + ' | stagger ' + staggerCoef.toFixed(2) + ' | ' +
        (ragdollActive ? '<span style="color:#f66">РЭГДОЛЛ</span>' : 'устойчив');
}

function updateMSInfo() {
    const stateColors = { IDLE:'#8cf', WALKING:'#8f8', RUNNING:'#ff8', FALLING:'#f88' };
    const c1 = stateColors[charState] || '#8cf';
    const c2 = slaveAlive ? '#9f9' : '#f99';
    const balTxt = (balanceEnabled && slaveAlive) ? '🧍баланс' : 'баланс выкл';
    const stagTxt = staggerCoef < 0.9 ? ' | 💫stagger' : '';
    msInfo.innerHTML =
        '<span style="color:' + c1 + '">MASTER: ' + charState + '</span>' + (groundedMaster ? '' : ' (air)') + ' | ' +
        '<span style="color:' + c2 + '">SLAVE: ' + slaveStateTxt + '</span> | ' + balTxt + stagTxt + '<br>' +
        'strength <b style="color:#fc8">' + (slaveStrength*100).toFixed(0) + '%</b> | ' +
        'коллизий: ' + collisionCount + ' | ' +
        'ошибка: ' + followErrPos.toFixed(1) + ' см / ' + followErrRot.toFixed(1) + '°';
}

function updateAngleLog() {
    if (!colliderRefs.length) return;
    const lines = [];
    lines.push('<div style="color:#88aacc;">🔄 ' + new Date().toLocaleTimeString('ru-RU', { hour12:false }) +
        ' | str ' + (slaveStrength*100).toFixed(0) + '% | foll ' + followingScale.toFixed(2) + '</div>');
    for (const ref of colliderRefs) {
        const child = ref.mesh.absoluteRotationQuaternion;
        if (!child || !ref.parentRef) continue;
        const par = ref.parentRef.mesh.absoluteRotationQuaternion;
        if (!par) continue;
        const deg = quatToEulerDeg(par.conjugate().multiply(child));
        if (!deg) continue;
        let mErr = '';
        if (ref.masterBone && masterMesh) {
            try {
                const mRot = ref.masterBone.getRotationQuaternion(BABYLON.Space.WORLD, masterMesh);
                if (mRot) {
                    let qe = child.conjugate().multiply(mRot);
                    if (qe.w < 0) qe = qe.scale(-1);
                    const d = (quatToRotVec(qe).length() / D2R).toFixed(1);
                    mErr = ' <span class="err">Δm ' + d + '°</span>';
                }
            } catch(_) {}
        }
        const gTag = (ref.isWelded && ref.groundContacts > 0) ? ' <span style="color:#666;">[опора]</span>' : '';
        const limpTag = (ref.limp > 0.05) ? ' <span style="color:#f66;">[limp ' + ref.limp.toFixed(2) + ']</span>' : '';
        const stressTag = (ref.stress > 0.15) ? ' <span style="color:#c9a;">[str ' + ref.stress.toFixed(2) + ']</span>' : '';
        const nm = ref.name.length > 12 ? ref.name.slice(0,11) + '…' : ref.name;
        lines.push('<div><span class="name">' + nm + (ref.isRoot ? '★' : '') + '</span> <span class="ang">' + fmtA(deg) + '</span>' + mErr + gTag + limpTag + stressTag + '</div>');
    }
    angleLogEl.innerHTML = lines.join('');
}

function populateSelect() {
    colliderSelect.innerHTML = '';
    colliderRefs.forEach((ref, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = ref.name + ' [' + ref.jt + ']';
        colliderSelect.appendChild(opt);
    });
    selectedIndex = 0;
    colliderSelect.selectedIndex = 0;
}
colliderSelect.addEventListener('change', () => { selectedIndex = parseInt(colliderSelect.value); });

// ======================================================================= импульсы
function applyImpulseTo(ref, speed) {
    if (!ref) return;
    wakeAll();
    let mass = 5;
    try { mass = ref.agg.body.getMass() || 5; } catch(_){}
    const dir = new BABYLON.Vector3(Math.random()-0.5, Math.random()*0.7+0.25, Math.random()-0.5).normalize();
    ref.agg.body.applyImpulse(dir.scale(speed * mass), ref.mesh.getAbsolutePosition());
    triggerHitReaction(ref, speed, dir, null);
    logToUI('💥 Импульс -> ' + ref.name + ' (J=' + (speed*mass).toFixed(0) + ' Н·с)', '#ffaa44');
}
impulseBtn.addEventListener('click', () => {
    if (selectedIndex < 0 || selectedIndex >= colliderRefs.length) { logToUI('Сначала загрузите модель', '#ffaa00'); return; }
    applyImpulseTo(colliderRefs[selectedIndex], parseFloat(impulseSpeedInput.value) || 6);
});
randomBtn.addEventListener('click', () => {
    if (!colliderRefs.length) { logToUI('Сначала загрузите модель', '#ffaa00'); return; }
    applyImpulseTo(colliderRefs[Math.floor(Math.random()*colliderRefs.length)], parseFloat(impulseSpeedInput.value) || 6);
});

// ======================================================================= пружинный захват + ОХРАНА ОПОРЫ
let dragEnabled = true, dragState = null;
$('dragToggle').addEventListener('change', () => { dragEnabled = $('dragToggle').checked; if (!dragEnabled) endDrag(); });
window.addEventListener('keydown', e => { if (e.key === 'Escape') endDrag(); });

canvas.addEventListener('pointerdown', evt => {
    if (!dragEnabled || dragState || evt.button !== 0) return;
    const pick = scene.pick(scene.pointerX, scene.pointerY, m => m.name.startsWith('col_') && m.isEnabled());
    if (!pick || !pick.hit || !pick.pickedPoint) return;
    const ref = colliderRefs.find(r => r.mesh === pick.pickedMesh);
    if (!ref) return;
    evt.preventDefault();
    camera.detachControl();
    const invW = BABYLON.Matrix.Invert(ref.mesh.getWorldMatrix());
    dragState = {
        ref,
        planeNormal: camera.getForwardRay().direction.clone().normalize(),
        planePoint: pick.pickedPoint.clone(),
        targetPoint: pick.pickedPoint.clone(),
        grabLocal: BABYLON.Vector3.TransformCoordinates(pick.pickedPoint, invW),
        savedAngDamp: P.angDamp
    };
    try { ref.agg.body.setAngularDamping(Math.max(P.angDamp, 4)); } catch(_){}
    try { ref.mesh.material.emissiveColor = new BABYLON.Color3(0.9,0.45,0.1); } catch(_){}
    wakeAll();
});
window.addEventListener('pointerup', () => { if (dragState) endDrag(); });

function updateDragSpring(dt) {
    const st = dragState;
    if (!st) return;
    const ray = scene.createPickingRay(scene.pointerX, scene.pointerY, BABYLON.Matrix.Identity(), camera);
    const den = BABYLON.Vector3.Dot(ray.direction, st.planeNormal);
    if (Math.abs(den) > 1e-6) {
        const tt = BABYLON.Vector3.Dot(st.planePoint.subtract(ray.origin), st.planeNormal) / den;
        if (tt > 0) st.targetPoint = ray.origin.add(ray.direction.scale(tt));
    }
    const body = st.ref.agg.body;
    try { body.wakeUp(); } catch(_){}
    const cur = BABYLON.Vector3.TransformCoordinates(st.grabLocal, st.ref.mesh.getWorldMatrix());
    let vel = BABYLON.Vector3.Zero();
    try { vel = body.getLinearVelocity(); } catch(_){}
    let mass = 1;
    try { mass = body.getMass() || 1; } catch(_){}
    const err = st.targetPoint.subtract(cur);
    const force = err.scale(P.dragStiff).subtract(vel.scale(P.dragDamp)).scaleInPlace(mass);
    const maxF = mass * 900;
    const fl = force.length();
    if (fl > maxF) force.scaleInPlace(maxF / fl);

    // ——— ОХРАНА ОПОРЫ: не даём захвату оторвать ноги от земли/куба ———
    if (supportGuard && rootRef && !ragdollActive) {
        feetSupportInfo = getFeetSupport();
        const fs = feetSupportInfo;
        if (fs.supported > 0 && fs.supportY !== null) {
            const maxY = fs.supportY + restRootAboveSupport * 0.99;
            const rootY = rootRef.mesh.getAbsolutePosition().y;
            if (rootY >= maxY - 0.04) {
                // таз у "потолка" (ноги выпрямлены, стоят на опоре) — подъём запрещён
                if (force.y > 0) { force.y = 0; guardClamped = true; }
                try {
                    const rv = rootRef.agg.body.getLinearVelocity();
                    if (rv.y > 0.05) rootRef.agg.body.setLinearVelocity(new BABYLON.Vector3(rv.x, 0, rv.z));
                } catch(_){}
            }
        }
    }

    try { body.applyForce(force, cur); } catch(_){}
}
function endDrag() {
    if (!dragState) return;
    const st = dragState;
    dragState = null;
    try { st.ref.agg.body.setAngularDamping(st.savedAngDamp); } catch(_){}
    try { st.ref.mesh.material.emissiveColor.copyFrom(st.ref.baseEmissive); } catch(_){}
    st.ref.lastTargetCOM = null;
    st.ref.lastMRot = null;
    camera.attachControl(canvas, true);
}

// ======================================================================= загрузка модели
fileInput.addEventListener('change', async e => {
    const file = e.target.files[0];
    if (!file) return;
    logToUI('📂 ' + file.name, '#88ddff');
    endDrag();
    disposeMaster();
    scene.meshes.forEach(m => {
        if (m !== ground && m !== ballMesh && !m.name.startsWith('obstacle_') && !m.name.startsWith('col_') && m.name !== 'master_avatar') m.dispose();
    });
    try {
        const url = URL.createObjectURL(file);
        const result = await BABYLON.SceneLoader.ImportMeshAsync('', url, '', scene, undefined, '.glb');
        URL.revokeObjectURL(url);
        if (!result.skeletons.length) throw new Error('Нет скелета');
        const skeleton = result.skeletons[0];
        const mesh = result.meshes.find(m => m.skeleton) || result.meshes[0];
        if (!mesh) throw new Error('Нет меша');
        scene.stopAllAnimations();

        mesh.computeWorldMatrix(true);
        const bb = mesh.getBoundingInfo().boundingBox;
        const size = bb.maximumWorld.subtract(bb.minimumWorld);
        const maxDim = Math.max(size.x, size.y, size.z);
        if (maxDim > 10) { mesh.scaling.scaleInPlace(2.0/maxDim); mesh.computeWorldMatrix(true); }
        const bb2 = mesh.getBoundingInfo().boundingBox;
        mesh.position.y -= bb2.minimumWorld.y;
        mesh.computeWorldMatrix(true);
        mesh.visibility = 1.0;

        const lm = computeLandmarksSkel(skeleton, mesh);
        createMaster(mesh, skeleton, lm, result.animationGroups);
        createRagdoll(skeleton, mesh, lm);

        if (masterMesh) {
            masterMesh.position.copyFrom(mesh.position);
            masterYaw = 0;
            masterFallVel = 0;
            masterMesh.computeWorldMatrix(true);
        }
        camera.target.copyFrom(mesh.position.add(new BABYLON.Vector3(0, size.y * mesh.scaling.x * 0.55, 0)));
        camera.radius = Math.max(4, size.y * mesh.scaling.x * 1.6);

        slaveAlive = true;
        slaveStrength = 1;
        slaveDeadStep = P.deadTime;
        collisionCount = 0;
        staggerTimer = 0;
        staggerCoef = 1;
        forceCoefficient = 1;
        torqueCoefficient = 1;
        resetStability();
        limpWaveQueue = [];
        logToUI('✅ Готово. Охрана опоры вкл: через куб не протащить, ноги не оторвать. Проверь захватом и ходьбой.', '#44ff44');
    } catch (err) {
        logToUI('❌ ' + err.message, '#ff4444');
        console.error(err);
    }
});

engine.runRenderLoop(() => scene.render());
window.addEventListener('resize', () => engine.resize());
logToUI('🟢 Загрузите модель. Опора читается коллизиями + рейкастами из стоп.', '#44ff44');
</script>
