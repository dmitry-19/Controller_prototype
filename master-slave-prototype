let ballMesh = null, ballAgg = null;
throwBallBtn.addEventListener('click', throwBall);
function throwBall() {
    if (!rootRef) { logToUI('Сначала загрузите модель', '#ffaa00'); return; }
    const target = rootRef.mesh.getAbsolutePosition().clone();
    const camPos = camera.position.clone();
    const dirToChar = target.subtract(camPos);
    dirToChar.y = 0;
    if (dirToChar.lengthSquared() < 1e-6) dirToChar.set(0,0,1);
    dirToChar.normalize();
    const spawn = camPos.add(dirToChar.scale(1.0));
    spawn.y = target.y;

    if (!ballMesh) {
        ballMesh = BABYLON.MeshBuilder.CreateSphere('ball', { diameter: 0.35 }, scene);
        const bm = new BABYLON.StandardMaterial('ballMat', scene);
        bm.diffuseColor = new BABYLON.Color3(1, 0.4, 0.2);
        bm.emissiveColor = new BABYLON.Color3(0.3, 0.08, 0.02);
        ballMesh.material = bm;
        ballAgg = new BABYLON.PhysicsAggregate(ballMesh, BABYLON.PhysicsShapeType.SPHERE, {
            mass: 4, restitution: 0.15, friction: 0.8,
            collisionGroup: COL_GROUP.GROUND, collisionMask: ~0
        }, scene);
        ballMesh.isPickable = false;
    }
    try { ballAgg.body.setTransformation(spawn, BABYLON.Quaternion.Identity()); } catch(_){}
    ballMesh.position.copyFrom(spawn);
    const speed = Math.max(4, parseFloat(impulseSpeedInput.value) || 8);
    try {
        ballAgg.body.setLinearVelocity(dirToChar.scale(speed));
        ballAgg.body.setAngularVelocity(BABYLON.Vector3.Zero());
        ballAgg.body.wakeUp();
    } catch(_){}
    logToUI('🎾 Шар брошен: ' + speed.toFixed(1) + ' м/с (m=4кг)', '#ffcc88');
}

